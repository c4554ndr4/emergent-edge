{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/pipeline",
      "destination": "/index.html"
    },
    {
      "source": "/pipeline.html",
      "destination": "/index.html"
    },
    {
      "source": "/pipeline-v2.html",
      "destination": "/index.html"
    },
    {
      "source": "/viz",
      "destination": "/index.html"
    },
    {
      "source": "/viz.html",
      "destination": "/index.html"
    },
    {
      "source": "/viz-v2.html",
      "destination": "/index.html"
    },
    {
      "source": "/index-v2.html",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
