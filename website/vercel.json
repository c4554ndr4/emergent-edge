{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/pipeline",
      "destination": "/pipeline.html"
    },
    {
      "source": "/viz",
      "destination": "/viz.html"
    },
    {
      "source": "/site/novelty-review/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-HeDULTpfM1r7XxYoS4OUN8pbTi25wQBluhf2RG4QphU=' 'sha256-vHX2GiOEkdY/1w/S6gFytflQKvSYfA7nEVCrAjjIzwQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pipeline-v2-standalone.html",
      "destination": "/pipeline.html",
      "permanent": false
    },
    {
      "source": "/viz-v2-standalone.html",
      "destination": "/viz.html",
      "permanent": false
    },
    {
      "source": "/viz-v2.html",
      "destination": "/viz.html",
      "permanent": false
    },
    {
      "source": "/index-v2.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/pipeline-v2.html",
      "destination": "/pipeline.html",
      "permanent": false
    },
    {
      "source": "/viz-v2",
      "destination": "/viz.html",
      "permanent": false
    },
    {
      "source": "/index-v2",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/pipeline-v2",
      "destination": "/pipeline.html",
      "permanent": false
    }
  ]
}
